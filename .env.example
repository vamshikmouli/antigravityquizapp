PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/quizapp
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SESSION_CODE_LENGTH=6
MAX_STUDENTS_PER_SESSION=50
BUZZER_TIMEOUT_MS=10000

# REQUIRED: secret used to sign/verify quiz-app session JWTs. Server refuses to boot if unset.
JWT_SECRET=change-me-to-a-long-random-string

# SSO: shared HS256 secrets for trusted host apps. Each must match the secret the
# corresponding host app uses to mint SSO tokens. Only required if that source is used.
QUIZ_SSO_SECRET_JDV=change-me-jdv-shared-secret
QUIZ_SSO_SECRET_CLASSO=change-me-classo-shared-secret
