PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/quizapp
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SESSION_CODE_LENGTH=6
MAX_STUDENTS_PER_SESSION=50
BUZZER_TIMEOUT_MS=10000

# REQUIRED: secret used to sign/verify quiz-app session JWTs. Server refuses to boot if unset.
JWT_SECRET=change-me-to-a-long-random-string

# SSO: shared HS256 secrets for trusted host apps. Each must match the secret the
# corresponding host app uses to mint SSO tokens. Only required if that source is used.
QUIZ_SSO_SECRET_JDV=change-me-jdv-shared-secret
QUIZ_SSO_SECRET_CLASSO=change-me-classo-shared-secret

# Standalone Google sign-in (Phase 3). OAuth 2.0 Web client id from Google Cloud
# Console. If unset, Google login is simply disabled (the button is hidden). The
# same value is served to the frontend via GET /api/auth/config. See GOOGLE_AUTH.md.
GOOGLE_CLIENT_ID=

# AI question generation. Configure one or more providers; the "Generate with AI"
# feature is enabled when at least one key is set. See AI_QUESTIONS.md.
# AI_PROVIDER picks the default when several are configured (groq | gemini).
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
