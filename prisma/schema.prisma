generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Question {
  id             String   @id @default(uuid())
  text           String
  type           QuestionType
  ownerId        String?  // Optional for now to support public questions
  owner          User?    @relation(fields: [ownerId], references: [id])
  
  quizId         String?
  quiz           Quiz?    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  // Multi-tenant scoping (Phase 2): denormalized from the owner at creation time
  // so queries can filter by tenant as defense-in-depth alongside ownerId.
  tenantId       String?
  schoolId       String?

  options        String[] // Array of answer options
  correctAnswer  String
  points         Int      @default(100)
  negativePoints Int      @default(25)
  timeLimit      Int      @default(30) // seconds
  round          Int      @default(1)
  imageUrl       String?  // Image for the question
  optionImages   String[] // Images for options (MCQ/Buzzer)
  readingTime    Int      @default(0)  // Seconds to wait before buzzer activates
  // Clue round: clues revealed one by one; cluePoints[i] = points if answered after clue i+1.
  clues          String[] @default([])
  cluePoints     Int[]    @default([])
  musicFile      String?
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  sessions       SessionQuestion[]
  answers        Answer[]
}

enum QuestionType {
  MULTIPLE_CHOICE
  BUZZER
  ORAL_BUZZER
  ORAL_OPEN
  TRUE_FALSE
  SHORT_ANSWER
  CLUE
}

model Quiz {
  id          String     @id @default(uuid())
  title       String
  description String?
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id])
  // Multi-tenant scoping (Phase 2): denormalized from the owner at creation time.
  tenantId    String?
  schoolId    String?
  questions   Question[]
  sessions    Session[]
  // Competition (team) mode: CLASSIC = everyone answers everything (default);
  // TEAMS = one phone per group, per-round formats, passes and elimination.
  mode          String   @default("CLASSIC")
  // [{ round, name, format: DIRECTED|ALL|BUZZER|CLUE, passOnWrong, passPercent,
  //    passTimeLimit, eliminate }]
  roundSettings Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?  // Optional: SSO / social-login users have no local password
  name      String?
  createdAt DateTime @default(now())

  // Multi-tenant / SSO fields (Phase 1)
  tenantId     String? // Which host app / tenant this user belongs to (e.g. a Classo tenant)
  schoolId     String? // School within the tenant
  authProvider String  @default("EMAIL") // EMAIL | SSO_JDV | SSO_CLASSO | (future: GOOGLE, PHONE)
  externalId   String? // The user's id in the source system (JWT `sub`)
  phone        String?

  quizzes     Quiz[]
  questions   Question[]
  sessions    Session[]
  musicTracks MusicTrack[]

  // One SSO identity per (tenant, external user) — used for SSO upserts
  @@unique([tenantId, externalId])
}

model Session {
  id                   String   @id @default(uuid())
  code                 String   @unique // e.g., "ABC-123"
  hostId               String
  host                 User     @relation(fields: [hostId], references: [id])
  // Multi-tenant scoping (Phase 2): denormalized from the host at creation time.
  tenantId             String?
  schoolId             String?

  quizId               String?
  quiz                 Quiz?    @relation(fields: [quizId], references: [id])

  currentQuestionIndex Int      @default(0)
  status               SessionStatus @default(WAITING)
  musicEnabled         Boolean  @default(true)
  musicVolume          Float    @default(0.5)
  showLiveResults      Boolean  @default(true)
  allowLateJoin        Boolean  @default(false)
  // Read-aloud: each question opens without options or timer until the host shows them.
  readAloud            Boolean  @default(false)
  createdAt            DateTime @default(now())
  completedAt          DateTime?
  
  // Relations
  questions            SessionQuestion[]
  participants         Participant[]
  analytics            Analytics?
  buzzerPresses        BuzzerPress[]
}

enum SessionStatus {
  WAITING
  ACTIVE
  PAUSED
  COMPLETED
}

enum MusicTrackType {
  QUESTION
  OPTIONS
  ANSWER
  ROUND_RESULTS
  FINAL_RESULTS
}

model MusicTrack {
  id        String         @id @default(uuid())
  type      MusicTrackType
  filename  String
  url       String
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  
  @@unique([ownerId, type])
}

model SessionQuestion {
  id         String   @id @default(uuid())
  sessionId  String
  questionId String
  order      Int
  
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])
  
  @@unique([sessionId, order])
}

model Participant {
  id          String   @id @default(uuid())
  sessionId   String
  name        String
  score       Int      @default(0)
  buzzerWins  Int      @default(0)
  joinedAt    DateTime @default(now())
  // Competition mode: set when the group is knocked out.
  eliminatedAt    DateTime?
  eliminatedRound Int?
  
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers     Answer[]
  
  @@unique([sessionId, name])
}

model Answer {
  id            String   @id @default(uuid())
  participantId String
  questionId    String
  answer        String
  isCorrect     Boolean
  points        Int
  timeToAnswer  Int?     // milliseconds
  timestamp     DateTime @default(now())
  
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id])
  
  @@unique([participantId, questionId])
}

model Analytics {
  id                 String   @id @default(uuid())
  sessionId          String   @unique
  totalStudents      Int
  averageScore       Float
  questionStats      Json     // Flexible JSON for question-level stats
  topPerformers      Json     // Array of top performers
  detailedResults    Json?    // NEW: All participant results grouped by round
  scoreDistribution  Json     // Score ranges and counts
  buzzerStats        Json     // Buzzer-specific analytics
  createdAt          DateTime @default(now())
  
  session            Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Audit trail for buzzer rounds: every press attempt with the numbers used to
// judge it, so disputes can be reviewed and thresholds tuned from real data.
// Written after the round is decided (never on the judging hot path).
model BuzzerPress {
  id              String   @id @default(uuid())
  sessionId       String
  questionId      String
  roundId         String
  participantId   String
  participantName String?
  claimedMs       Int?     // reaction time reported by the phone
  observedMs      Int?     // server: press arrival - OPEN sent
  rttMs           Int?     // OPEN round trip (sent -> ack after paint)
  creditMs        Int?     // latency credited after caps
  effectiveMs     Int?     // the time that was ranked
  flags           String[]
  outcome         String   // WON | LOST | LATE | REJECTED | OVERRIDDEN
  tenantId        String?
  createdAt       DateTime @default(now())

  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, questionId])
  @@index([roundId])
}
